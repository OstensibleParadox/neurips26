cat > split_by_chinese.py << 'EOF'
#!/usr/bin/env python3
import re

def split_by_chinese_chars(filename, chunk_size=4000):
    # 读取文件
    with open(filename, 'r', encoding='utf-8') as f:
        content = f.read()
    
    # 提取中文字符（Unicode 4E00-9FFF 范围）
    chinese_chars = re.findall(r'[\u4e00-\u9fff]', content)
    total_chinese = len(chinese_chars)
    
    print(f"总中文字符数: {total_chinese}")
    print(f"每份: {chunk_size} 字")
    print(f"将分成: {(total_chinese + chunk_size - 1) // chunk_size} 份")
    
    # 按中文字符位置切分
    chunks = []
    current_chunk = []
    char_count = 0
    
    for char in content:
        current_chunk.append(char)
        if re.match(r'[\u4e00-\u9fff]', char):
            char_count += 1
            if char_count >= chunk_size:
                chunks.append(''.join(current_chunk))
                current_chunk = []
                char_count = 0
    
    # 添加最后一部分
    if current_chunk:
        chunks.append(''.join(current_chunk))
    
    # 保存文件
    for i, chunk in enumerate(chunks, 1):
        output_file = f"book_part_{i:03d}.txt"
        with open(output_file, 'w', encoding='utf-8') as f:
            f.write(chunk)
        print(f"已创建: {output_file}")
    
    print(f"完成！共创建 {len(chunks)} 个文件")

if __name__ == "__main__":
    split_by_chinese_chars("book.txt", 4000)
EOF

# 运行脚本
python3 split_by_chinese.py
